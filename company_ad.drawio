          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="FdtgiW_92DGW34-r7_0Z-38" parent="1" style="whiteSpace=wrap;html=1;" value="buildRequest方法中，将Glide配置赋值，load(url)...&lt;br&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); color: rgb(0, 51, 179);&quot;&gt;val &lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); color: rgb(0, 0, 0);&quot;&gt;requestManager &lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); color: light-dark(rgb(8, 8, 8), rgb(230, 230, 230));&quot;&gt;= &lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); color: rgb(0, 0, 0);&quot;&gt;Glide&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); color: light-dark(rgb(8, 8, 8), rgb(230, 230, 230));&quot;&gt;.with(&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); color: rgb(0, 0, 0);&quot;&gt;ctx&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 9.8pt; background-color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); color: light-dark(rgb(8, 8, 8), rgb(230, 230, 230));&quot;&gt;)&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="310" x="670" y="720" as="geometry" />
        </mxCell>
        <mxCell id="FdtgiW_92DGW34-r7_0Z-40" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="450" width="298" x="1020" y="610" as="geometry" />
        </mxCell>
        <mxCell id="FdtgiW_92DGW34-r7_0Z-43" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="RequestBuilder&amp;lt;Drawable&amp;gt;是个构建器，buildRequest方法返回就是这个构建器，也就是这样的形式&lt;br&gt;Glide.with(context)&lt;br&gt;.load(url)&lt;br&gt;...&lt;br&gt;.into(imageview)&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;但注意，load()的url是不可变的。这个配置虽然可以分开写，但重新再写一次load。所以将这个其他的配置抽象出来成RequestOptions。使用方法如下：&lt;br&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(129, 0, 194);&quot;&gt;val&lt;/span&gt; options &lt;span class=&quot;token token&quot; style=&quot;color: rgb(20, 24, 31);&quot;&gt;=&lt;/span&gt; &lt;span class=&quot;token token&quot; style=&quot;color: rgb(0, 81, 194);&quot;&gt;RequestOptions&lt;/span&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;)&lt;/span&gt;&lt;br/&gt;    &lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;.&lt;/span&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(0, 81, 194);&quot;&gt;placeholder&lt;/span&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;(&lt;/span&gt;R&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;.&lt;/span&gt;drawable&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;.&lt;/span&gt;loading&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;)&lt;/span&gt;&lt;br/&gt;    &lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;.&lt;/span&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(0, 81, 194);&quot;&gt;error&lt;/span&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;(&lt;/span&gt;R&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;.&lt;/span&gt;drawable&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;.&lt;/span&gt;error&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;)&lt;/span&gt;&lt;br/&gt;    &lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;.&lt;/span&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(0, 81, 194);&quot;&gt;centerCrop&lt;/span&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;)&lt;/span&gt;&lt;br/&gt;    &lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;.&lt;/span&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(0, 81, 194);&quot;&gt;diskCacheStrategy&lt;/span&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;(&lt;/span&gt;DiskCacheStrategy&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;.&lt;/span&gt;ALL&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;)&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(110, 118, 135);&quot;&gt;// 等到拿到 url 之后&lt;/span&gt;&lt;br/&gt;networkRequest &lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;{&lt;/span&gt; imageUrl &lt;span class=&quot;token token&quot; style=&quot;color: rgb(20, 24, 31);&quot;&gt;-&amp;gt;&lt;/span&gt;&lt;br/&gt;    Glide&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;.&lt;/span&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(0, 81, 194);&quot;&gt;with&lt;/span&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;(&lt;/span&gt;context&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;)&lt;/span&gt;&lt;br/&gt;        &lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;.&lt;/span&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(0, 81, 194);&quot;&gt;load&lt;/span&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;(&lt;/span&gt;imageUrl&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;)&lt;/span&gt;      &lt;span class=&quot;token token&quot; style=&quot;color: rgb(110, 118, 135);&quot;&gt;// url 在这里才传入&lt;/span&gt;&lt;br/&gt;        &lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;.&lt;/span&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(0, 81, 194);&quot;&gt;apply&lt;/span&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;(&lt;/span&gt;options&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;)&lt;/span&gt;      &lt;span class=&quot;token token&quot; style=&quot;color: rgb(110, 118, 135);&quot;&gt;// 复用之前的配置&lt;/span&gt;&lt;br/&gt;        &lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;.&lt;/span&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(0, 81, 194);&quot;&gt;into&lt;/span&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;(&lt;/span&gt;imageView&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;)&lt;/span&gt;&lt;br/&gt;&lt;span class=&quot;token token&quot; style=&quot;color: rgb(43, 48, 59);&quot;&gt;}&lt;/span&gt;&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
