        <mxCell id="BtXMLl_vS57XNX6S4cZ_-28" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;p data-pm-slice=&quot;0 0 []&quot;&gt;编译C/C++的三个步骤：&lt;/p&gt;&lt;p&gt;CMakeLists.txt - 生成编译命令&lt;/p&gt;&lt;p&gt;你写的配置文件&lt;/p&gt;&lt;p&gt;CMake根据它生成&quot;怎么编译&quot;的方案&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;compile_commands.json - 记录编译命令&lt;/p&gt;&lt;p&gt;CMake生成的文件&lt;/p&gt;&lt;p&gt;内容：所有源文件怎么编译的详细信息&lt;/p&gt;&lt;p&gt;这是CMake的输出&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;编译器（gcc/clang） - 真正编译&lt;/p&gt;&lt;p&gt;根据那些命令，真的编译代码&lt;/p&gt;" vertex="1">
          <mxGeometry height="290" width="300" x="1910" y="2450" as="geometry" />
        </mxCell>
        <mxCell id="BtXMLl_vS57XNX6S4cZ_-29" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="构建生成可执行文件，之后run运行烧录到板子里面" vertex="1">
